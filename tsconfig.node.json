{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // vite.config.ts uses Buffer and Node's http types in the GTFS proxy
    // middleware. @types/node used to arrive transitively; it is a declared
    // devDependency now so this does not silently break again.
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
